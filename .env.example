# Copier en .env.local pour `vercel dev`, et renseigner les mêmes variables
# dans Vercel > Project > Settings > Environment Variables.

# Clé secrète Stripe : sk_test_… pour les tests, sk_live_… en production
STRIPE_SECRET_KEY=

# Identifiant du prix récurrent (97 € TTC / mois) : price_…
STRIPE_PRICE_ID=

# Secret de signature du webhook : whsec_… (Dashboard > Développeurs > Webhooks, ou `stripe listen`)
STRIPE_WEBHOOK_SECRET=

# URL publique du site, sans slash final
SITE_URL=https://club.immoelite-formation.fr

# Optionnel : URL d'un Zap qui invite le membre dans Skool
SKOOL_INVITE_WEBHOOK_URL=
