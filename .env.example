# Copier en .env.local. Seule STRIPE_SECRET_KEY est à remplir à la main :
# `node scripts/stripe-setup.mjs` écrit les autres. Reporter ensuite les 4 valeurs
# dans Vercel > Project > Settings > Environment Variables.

# Clé secrète Stripe : sk_test_… pour les tests, sk_live_… en production
STRIPE_SECRET_KEY=

# Identifiant du prix récurrent (97 € TTC / mois) : price_…
STRIPE_PRICE_ID=

# Secret de signature du webhook : whsec_… (Dashboard > Développeurs > Webhooks, ou `stripe listen`)
STRIPE_WEBHOOK_SECRET=

# URL publique du site, sans slash final
SITE_URL=https://club.immoelite-formation.fr

# Optionnel : URL d'un Zap qui invite le membre dans Skool
SKOOL_INVITE_WEBHOOK_URL=

# E-mail de bienvenue (facture + lien d'accès Skool), envoyé par le SMTP OVH
SKOOL_GROUP_URL=
SMTP_USER=contact@immoelite-formation.fr
SMTP_PASS=
MAIL_BCC=

# ---------- Espace client de l'accompagnement individuel (/espace) ----------
# Clé qui signe les sessions de connexion : 32 caractères au moins, à générer avec
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ESPACE_SECRET=
# Adresse(s) e-mail de Mattéo : elles ouvrent la vue coach (séparées par des virgules)
ESPACE_ADMIN_EMAILS=
# Facultatif : adresse publique de l'espace dans les e-mails (défaut : celle d'où part l'action)
ESPACE_URL=https://espace.immoelite-formation.fr/espace
# Facultatif : destinataire des notifications (défaut : MAIL_NOTIFY, puis la 1re adresse ci-dessus)
ESPACE_NOTIFY=
# Facultatif : taille maximale d'un fichier déposé, en Mo (défaut 50)
ESPACE_MAX_FILE_MB=
# Le stockage des documents est un magasin Vercel Blob PRIVÉ relié au projet (aucune variable à saisir).
# Facultatif : Google Agenda + Google Meet (README, section 7). Identifiants OAuth « Application Web »,
# URI de redirection autorisé : https://espace.immoelite-formation.fr/api/espace-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facultatif : un autre agenda que l'agenda principal (son identifiant, visible dans ses paramètres)
GOOGLE_CALENDAR_ID=
